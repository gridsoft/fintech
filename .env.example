DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fintech
DB_USERNAME=root
DB_PASSWORD=
APP_ENV=local
APP_DEBUG=true

# УЈП е-фактура — оставено празно додека клиентот не обезбеди пристап до
# порталот и квалификуван дигитален сертификат. api_base_url/send_url веќе
# укажуваат на официјалната тест (sandbox) околина. Ништо тука не се чита
# додека UJP_EINVOICE_EUJP_ID и UJP_EINVOICE_EDB не се пополнети.
UJP_EINVOICE_API_BASE_URL=https://efakturatest.ujp.gov.mk/einvoice_api
UJP_EINVOICE_SEND_URL=https://efakturatest.ujp.gov.mk/JSONReceiver/api/v1/sales-invoices/send
UJP_EINVOICE_EUJP_ID=
UJP_EINVOICE_EDB=
UJP_EINVOICE_CERT_PATH=
UJP_EINVOICE_CERT_PASSWORD=
UJP_EINVOICE_CERT_SERIAL=
UJP_EINVOICE_SELLER_TIN=
UJP_EINVOICE_SELLER_VAT_NUMBER=
UJP_EINVOICE_SELLER_NAME=
UJP_EINVOICE_SELLER_COUNTRY_CODE=MK
UJP_EINVOICE_SELLER_STREET=
UJP_EINVOICE_SELLER_STREET_NUMBER=
UJP_EINVOICE_SELLER_POSTAL_CODE=
UJP_EINVOICE_SELLER_CITY=
